# Copy to .env.local and fill in.

# ---------------------------------------------------------------------------
# Site origin — the single source of truth for the canonical host.
#
# Read by lib/site.ts and used by metadataBase, every canonical, og:url, the
# sitemap, robots.txt and every JSON-LD @id. Set it WITHOUT a trailing slash.
#
# NEXT_PUBLIC_ so it is inlined at build time and available wherever metadata
# is generated. It is a public URL, not a secret.
#
# Leave it unset and the build falls back to https://www.handlancer.com.
# There is deliberately no VERCEL_URL fallback: preview deployments would
# otherwise emit canonicals pointing at a throwaway *.vercel.app origin and
# compete with production in the index.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://www.handlancer.com

# ---------------------------------------------------------------------------
# Waitlist storage. Both are read server-side only (no NEXT_PUBLIC_ prefix),
# so neither is exposed to the browser.
#
# Use the SAME project as the mobile app if you want one waitlist:
# the values are in ../../HandLancer/handlancer/.env as
# EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY.
#
# Use the anon key, NOT the service role key — row level security still applies
# to anon, and supabase/waitlist.sql grants it insert-only on one table.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
